# Copy to ".env" (same folder as pom.xml) and fill in. ".env" is git-ignored.

# MongoDB connection string (database name included)
MONGODB_URI=mongodb://localhost:27017/queue_management_db

# Required: at least 32 bytes. Generate with: openssl rand -base64 64
JWT_SECRET=
# Token lifetime in ms (default 86400000 = 24h)
JWT_EXPIRATION=86400000

# Gmail SMTP - use a Google "App Password", not your normal password
MAIL_USERNAME=
MAIL_PASSWORD=

# Razorpay (https://dashboard.razorpay.com/app/keys) - needed for the pricing pages
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Optional
# SERVER_PORT=8080
# CACHE_TYPE=caffeine            # or "redis" (then also REDIS_HOST / REDIS_PORT / REDIS_HEALTH_ENABLED=true)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
# FRONTEND_URL=https://localhost:5173
# FIREBASE_CREDENTIALS_PATH=file:./firebase-service-account.json
# SSL_ENABLED=false
# SSL_KEY_STORE=classpath:localhost.p12
# SSL_KEY_STORE_PASSWORD=
